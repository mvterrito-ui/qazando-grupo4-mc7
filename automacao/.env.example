# Copie este arquivo para .env e preencha com a SUA conta.
# O .env nunca vai para o git -- cada pessoa tem a sua.
#
#   cp .env.example .env
#
# Por que conta propria por pessoa: se todos usarem a mesma, um apaga o
# progresso do outro e o grupo reporta bug que nao existe.

BASE_URL=https://english.qazando.com.br

# A sua conta, criada em /auth
QA_EMAIL=voce@exemplo.com
QA_PASSWORD=suasenha

# Codigo premium -- e reutilizavel, o mesmo serve para todos
PREMIUM_CODE=QAZANDOENGLISH2025

# OPCIONAL: uma segunda conta SEM premium ativado.
# So e necessaria para os cenarios que testam o bloqueio de rota premium.
# Sem ela, esses cenarios sao pulados automaticamente.
QA_EMAIL_SEM_PREMIUM=
QA_PASSWORD_SEM_PREMIUM=
