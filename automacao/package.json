{
  "name": "qazando-grupo4-mc7-automacao",
  "version": "1.0.0",
  "private": true,
  "description": "Automacao web do projeto de testes do English QA - Grupo 4 (MC7)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:falhos": "playwright test --last-failed",
    "test:login": "playwright test --project=setup",
    "test:parte-2": "playwright test tests/parte-2-pratica-estruturada",
    "test:parte-4": "playwright test tests/parte-4-conteudo-com-ia",
    "test:microfone": "playwright test --project=microfone --project=microfone-negado",
    "test:trilha": "playwright test tests/parte-2-pratica-estruturada/trilha",
    "test:exercicios": "playwright test tests/parte-2-pratica-estruturada/exercises",
    "test:flashcards": "playwright test tests/parte-2-pratica-estruturada/flashcards",
    "test:historinhas": "playwright test tests/parte-4-conteudo-com-ia/stories",
    "test:entrevistas": "playwright test tests/parte-4-conteudo-com-ia/interview",
    "test:chatbot": "playwright test tests/parte-4-conteudo-com-ia/chatbot",
    "test:palavras": "playwright test tests/parte-4-conteudo-com-ia/words",
    "test:pronuncia": "playwright test tests/parte-4-conteudo-com-ia/pronunciation",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://english.qazando.com.br"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "dotenv": "^16.4.5"
  }
}
